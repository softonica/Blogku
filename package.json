{
  "name": "blogku",
  "version": "0.0.1-alpha",
  "private": true,
  "description": "Blogku — Modern Magazine & Digital Editorial Platform (Monorepo)",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "build": "npm --workspace=frontend run build",
    "preview": "npm --workspace=frontend run preview",
    "typecheck": "npm --workspace=frontend run typecheck",
    "lint": "npm --workspace=frontend run lint",
    "test": "npm --workspace=frontend run test"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.7"
    },
    "postcss-selector-parser": "^7.1.7"
  }
}
